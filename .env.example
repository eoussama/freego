# Used by the examples (examples/) and the Docker development image (scripts/).
# The library itself does not read environment variables.

# Global
GLOBAL_VERSION=0.1.0

# Webhook
FREEGO_WEBHOOK_PORT=8080
FREEGO_WEBHOOK_ROUTE=/webhook
# Set to true behind proxies that hide response headers, such as smee
FREEGO_WEBHOOK_ACCEPT_ANY_DATE=false

# FreeStuff (https://dashboard.freestuffbot.xyz/ > my application)
FREEGO_FREESTUFF_API_KEY=
FREEGO_FREESTUFF_PUBLIC_KEY=
# Optional, defaults to https://api.freestuffbot.xyz/v2
FREEGO_FREESTUFF_API_URL=
